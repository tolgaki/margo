<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Margo.Cloud.StateCli</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>margo-state</AssemblyName>
    <!--
      Contract probes (Margo.Cloud.State.Probes) run arbitrary SQL and write files; only the parity judge needs them.
      Debug builds include them unless told otherwise; Release builds never do unless MargoStateProbes=true is passed.
    -->
    <MargoStateProbes Condition="'$(MargoStateProbes)' == '' and '$(Configuration)' == 'Debug'">true</MargoStateProbes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Margo.Cloud.State.Core/Margo.Cloud.State.Core.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Work/Margo.Cloud.State.Work.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Proactive/Margo.Cloud.State.Proactive.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Tasks/Margo.Cloud.State.Tasks.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Memory/Margo.Cloud.State.Memory.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.MemorySearch/Margo.Cloud.State.MemorySearch.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.MemoryLearning/Margo.Cloud.State.MemoryLearning.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.MemoryCommands/Margo.Cloud.State.MemoryCommands.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Helpers/Margo.Cloud.State.Helpers.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MargoStateProbes)' == 'true'">
    <ProjectReference Include="../Margo.Cloud.State.Probes/Margo.Cloud.State.Probes.csproj" />
  </ItemGroup>

</Project>
