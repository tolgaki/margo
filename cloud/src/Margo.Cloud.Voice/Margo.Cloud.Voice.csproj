<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Margo.Cloud.Voice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Margo.Cloud.Voice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Margo.Cloud.Core/Margo.Cloud.Core.csproj" />
    <ProjectReference Include="../Margo.Cloud.Guard/Margo.Cloud.Guard.csproj" />
    <ProjectReference Include="../Margo.Cloud.Engine/Margo.Cloud.Engine.csproj" />
    <ProjectReference Include="../Margo.Cloud.Orchestrator/Margo.Cloud.Orchestrator.csproj" />
    <ProjectReference Include="../Margo.Cloud.State.Core/Margo.Cloud.State.Core.csproj" />
    <!-- Voice Live authentication (managed identity), as the Python server used azure-identity. Already a dependency
         of Margo.Cloud.Engine; the version is the central one. -->
    <PackageReference Include="Azure.Identity" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser page in wwwroot/, embedded and served unchanged. Only the files VoiceEndpoints.Files serves; the
         page's node tests and README stay out. -->
    <EmbeddedResource Include="wwwroot/index.html" LogicalName="voice/index.html" />
    <EmbeddedResource Include="wwwroot/voice.css" LogicalName="voice/voice.css" />
    <EmbeddedResource Include="wwwroot/voice.js" LogicalName="voice/voice.js" />
    <EmbeddedResource Include="wwwroot/voice-core.mjs" LogicalName="voice/voice-core.mjs" />
    <EmbeddedResource Include="wwwroot/pcm-worklets.js" LogicalName="voice/pcm-worklets.js" />
  </ItemGroup>

</Project>
