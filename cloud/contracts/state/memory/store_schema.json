        {
          "call": "__init__",
          "on": "store"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${kept.id}"
          ]
        },
        {
          "script": "CREATE TABLE memory_extra (x TEXT);"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "script": "DROP TABLE memory_extra;"
        },
        {
