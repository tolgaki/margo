        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "sql": "DELETE FROM memory_meta WHERE key='schema_version'"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "sql": "INSERT INTO memory_meta VALUES('schema_version','2')"
        },
        {
          "sql": "UPDATE margo_meta SET value='9' WHERE key='memory_schema_version'"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "call": "__init__",
          "on": "store",
          "migrate": true
        },
        {
          "sql": "DELETE FROM margo_meta WHERE key='memory_schema_version'"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "call": "__init__",
          "on": "store",
          "read_only": true
        },
        {
          "sql": "INSERT INTO margo_meta VALUES('memory_schema_version',2)"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "sql": "UPDATE margo_meta SET value='2' WHERE key='memory_schema_version'"
        },
        {
          "call": "__init__",
          "on": "store"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${kept.id}"
