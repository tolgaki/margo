{
  "description": "File sources: a verified SHA-256 is required, the hash is re-checked by eligibility and health (changed, oversized, at-limit, relative, home-relative, dotted, symlinked, directory, missing and unreadable files; an unknown ~user raises RuntimeError as pathlib does).",
  "steps": [
    {
      "script": "memory_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "write": "profile.txt",
          "text": "Saved fact"
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "no-hash",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "${dir}/profile.txt"
                }
              ]
            },
            "active"
          ]
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "file-fact",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "${dir}/profile.txt",
                  "revision": "b34a3abdea945341efa6f0cefc0114c5f579bee7e44c7733061602ad1577c1ef"
                }
              ]
            },
            "active"
          ],
          "save": "ff"
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "relative",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "relative.txt",
                  "revision": "b34a3abdea945341efa6f0cefc0114c5f579bee7e44c7733061602ad1577c1ef"
                }
              ]
            },
            "active"
          ]
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "home",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "~/../work/profile.txt",
                  "revision": "b34a3abdea945341efa6f0cefc0114c5f579bee7e44c7733061602ad1577c1ef"
                }
              ]
            },
            "active"
          ]
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "dotted",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "${dir}/./sub/../profile.txt",
                  "revision": "b34a3abdea945341efa6f0cefc0114c5f579bee7e44c7733061602ad1577c1ef"
                }
              ]
            },
            "active"
          ]
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "unknown-user",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
                  "ref": "~no-such-margo-user/x",
                  "revision": "b34a3abdea945341efa6f0cefc0114c5f579bee7e44c7733061602ad1577c1ef"
                }
              ]
            },
            "candidate"
          ]
        },
        {
          "mkdir": "sub"
        },
        {
          "symlink": "link.txt",
          "target": "${dir}/profile.txt"
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "symlinked",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Synthetic review preparation",
              "text": "A fictional review benefited from preparation time.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "file",
