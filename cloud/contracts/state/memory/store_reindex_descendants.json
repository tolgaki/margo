            "put-linked",
            {
              "domain": "user",
              "kind": "episode",
              "title": "Parent fact",
              "text": "Cedar ships in March.",
              "authority": "source_observed",
              "scope": "personal",
              "source_refs": [
                {
                  "kind": "tool_result",
                  "ref": "tool:synthetic-result"
                }
              ]
            },
            "active"
          ],
          "save": "put_linked_parent"
        },
