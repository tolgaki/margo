{
  "description": "memory_encoder.status/status_local/encode_local exactly as Python behaves without the optional runtime: unsafe default model directory, explicit and environment model directories, missing, unreadable, non-private, symlinked, invalid and expected manifests (asset verification then fails), asset size/hash/mode checks and the missing private interpreter.",
  "steps": [
    {
      "script": "memory_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "call": "_runtime_available",
          "on": "encoder"
        },
        {
          "call": "_copilot_home",
          "on": "encoder"
        },
        {
          "call": "default_model_dir",
          "on": "encoder"
        },
        {
          "call": "_private_python",
          "on": "encoder"
        },
        {
          "call": "_safe_model_path",
          "on": "encoder"
        },
        {
          "call": "status",
          "on": "encoder"
        },
        {
          "call": "status_local",
          "on": "encoder"
        },
        {
          "call": "_validate_model",
          "on": "encoder",
          "args": [
            null
          ]
        },
        {
          "call": "encode_local",
          "on": "encoder",
          "args": [
            [
              "Synthetic text"
            ]
          ]
        },
        {
          "call": "encode_local",
          "on": "encoder",
          "args": [
            []
          ]
        },
        {
          "call": "encode_local",
          "on": "encoder",
          "args": [
            [
              ""
            ]
          ]
        },
        {
          "call": "encode_local",
          "on": "encoder",
          "args": [
            "not a list"
          ]
        },
        {
          "call": "_safe_model_path",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "_validate_model",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "mkdir": "model",
          "mode": "700"
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "_expected_manifest",
          "on": "encoder",
          "save": "manifest"
        },
        {
          "write": "model/manifest.json",
          "json": "${manifest}",
          "mode": "600"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "_validate_model",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "chmod": "model/manifest.json",
          "mode": "644"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "chmod": "model/manifest.json",
          "mode": "600"
        },
        {
          "write": "model/manifest.json",
          "json": {
            "format_version": 1.0,
            "identity": "${manifest.identity}",
            "model_fingerprint": "${manifest.model_fingerprint}",
            "assets": "${manifest.assets}"
          }
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "json": {
            "format_version": 2
          }
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "text": "{not json"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "hex": "ff00"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "text": "﻿{}"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "text": "[]"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/manifest.json",
          "text": "null"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/model"
          ]
        },
        {
          "write": "model/real-manifest.json",
          "json": "${manifest}",
          "mode": "600"
        },
        {
          "write": "model/manifest.json",
          "text": "x",
          "mode": "600"
        },
        {
          "mkdir": "linked",
          "mode": "700"
        },
        {
          "symlink": "linked/manifest.json",
          "target": "${dir}/model/real-manifest.json"
        },
        {
          "call": "_read_manifest",
          "on": "encoder",
          "args": [
            "${dir}/linked"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/linked"
          ]
        },
        {
          "call": "_safe_model_path",
          "on": "encoder",
          "args": [
            "${dir}/linked/../model"
          ]
        },
        {
          "symlink": "alias",
          "target": "${dir}/model"
        },
        {
          "call": "_safe_model_path",
          "on": "encoder",
          "args": [
            "${dir}/alias"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "${dir}/alias"
          ]
        },
        {
          "mkdir": "model/onnx",
          "mode": "700"
        },
        {
          "write": "model/tokenizer_config.json",
          "text": "",
          "mode": "600"
        },
        {
          "call": "_verify_asset",
          "on": "encoder",
          "args": [
            "${dir}/model/tokenizer_config.json",
            2
          ]
        },
        {
          "call": "_verify_asset",
          "on": "encoder",
          "args": [
            "${dir}/model/tokenizer_config.json",
            3
          ]
        },
        {
          "chmod": "model/tokenizer_config.json",
          "mode": "640"
        },
        {
          "call": "_verify_asset",
          "on": "encoder",
          "args": [
            "${dir}/model/tokenizer_config.json",
            2
          ]
        },
        {
          "call": "_verify_asset",
          "on": "encoder",
          "args": [
            "${dir}/model/missing.json",
            2
          ]
        },
        {
          "call": "_verify_asset",
          "on": "encoder",
          "args": [
            "${dir}/model",
            2
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "~/model-in-home"
          ]
        },
        {
          "call": "status",
          "on": "encoder",
          "args": [
            "relative/model"
          ]
        }
      ],
      "expect_exit": 0
    }
  ]
}
