{
  "description": "capacity.py command line: help (and COLUMNS wrapping), argparse errors (missing --input, missing value, extra and unknown arguments), --input=- and abbreviations, file input with pathlib's normalised name in errors (missing file, directory, '' as '.', a file used as a directory), universal newlines in error positions, BOM, invalid and truncated UTF-8, empty files.",
  "steps": [
    {"script": "capacity.py", "args": ["-h"], "expect_exit": 0},
    {"script": "capacity.py", "args": ["--help"], "env": {"COLUMNS": "40"}, "expect_exit": 0},
    {"script": "capacity.py", "args": [], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "-", "extra"], "stdin": "{\n \"coverage\": \"complete\",\n \"working\": [\n  {\n   \"start\": \"2026-09-07T09:00:00-07:00\",\n   \"end\": \"2026-09-07T17:00:00-07:00\"\n  }\n ],\n \"busy\": [],\n \"estimates\": [\n  {\n   \"id\": \"a\",\n   \"minutes\": 30\n  }\n ]\n}", "expect_exit": 2},
    {"script": "capacity.py", "args": ["--bogus", "x", "--input", "-"], "stdin": "{\n \"coverage\": \"complete\",\n \"working\": [\n  {\n   \"start\": \"2026-09-07T09:00:00-07:00\",\n   \"end\": \"2026-09-07T17:00:00-07:00\"\n  }\n ],\n \"busy\": [],\n \"estimates\": [\n  {\n   \"id\": \"a\",\n   \"minutes\": 30\n  }\n ]\n}", "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input=-"], "stdin": "{\n \"coverage\": \"complete\",\n \"working\": [\n  {\n   \"start\": \"2026-09-07T09:00:00-07:00\",\n   \"end\": \"2026-09-07T17:00:00-07:00\"\n  }\n ],\n \"busy\": [],\n \"estimates\": [\n  {\n   \"id\": \"a\",\n   \"minutes\": 30\n  }\n ]\n}", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--in", "-"], "stdin": "{\n \"coverage\": \"complete\",\n \"working\": [\n  {\n   \"start\": \"2026-09-07T09:00:00-07:00\",\n   \"end\": \"2026-09-07T17:00:00-07:00\"\n  }\n ],\n \"busy\": [],\n \"estimates\": [\n  {\n   \"id\": \"a\",\n   \"minutes\": 30\n  }\n ]\n}", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "-", "--input", "missing.json"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "missing.json"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "./sub//./missing.json/"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "{root}"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", ""], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "/"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write", "plan.json"], "stdin": "{\n \"coverage\": \"complete\",\n \"working\": [\n  {\n   \"start\": \"2026-09-07T09:00:00-07:00\",\n   \"end\": \"2026-09-07T17:00:00-07:00\"\n  }\n ],\n \"busy\": [],\n \"estimates\": [\n  {\n   \"id\": \"a\",\n   \"minutes\": 30\n  }\n ]\n}", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "plan.json"], "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "{root}/plan.json"], "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "plan.json/x"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write", "crlf.json"], "stdin": "{\r\n \"coverage\": \"complete\",\r\n \"working\": [],\r\n \"busy\": [],\r\n}\r\n", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "crlf.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write", "cr.json"], "stdin": "{\r\"coverage\":\r1}", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "cr.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write-hex", "bom.json"], "stdin": "efbbbf7b7d", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "bom.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write-hex", "latin1.json"], "stdin": "7b22636f766572616765223a2022e9227d", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "latin1.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write-hex", "truncated.json"], "stdin": "2020e282", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "truncated.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write-hex", "surrogate.json"], "stdin": "22eda080", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "surrogate.json"], "expect_exit": 2},
    {"script": "helpers_probe.py", "args": ["write-hex", "empty.json"], "stdin": "", "expect_exit": 0},
    {"script": "capacity.py", "args": ["--input", "empty.json"], "expect_exit": 2},
    {"script": "capacity.py", "args": ["--input", "/dev/null"], "expect_exit": 2}
  ]
}
