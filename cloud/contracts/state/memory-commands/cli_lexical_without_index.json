{
 "description": "tests/test_memory_review_regressions.py::test_lexical_reads_do_not_create_a_missing_semantic_index and test_cli_rebuild_repairs_empty_cache_and_drains_deletes_without_model on a store created by put only (no init, so no semantic tables until status creates them)",
 "steps": [
  {
   "script": "memory_commands_probe.py",
   "args": [
    "--account",
    "{account}",
    "--state-dir",
    "{state_dir}",
    "--dir",
    "{root}/probe"
   ],
   "stdin": [
    {
     "cli": [
      "put",
      "lexical-only",
      "--input",
      "-"
     ],
     "stdin_json": {
      "data": {
       "domain": "user",
       "kind": "episode",
       "title": "Lexical only",
       "text": "A private fictional observation.",
       "authority": "source_observed",
       "scope": "personal",
       "source_refs": [
        {
         "kind": "tool_result",
         "ref": "synthetic:cli"
        }
       ]
      },
      "status": "active"
     }
    },
    {
     "sql": "SELECT count(*) FROM sqlite_master WHERE name LIKE 'semantic_%'"
    },
    {
     "cli": [
      "search",
      "Lexical",
      "--mode",
      "lexical"
     ]
    },
    {
     "sql": "SELECT count(*) FROM sqlite_master WHERE name LIKE 'semantic_%'"
    },
    {
     "cli": [
      "put",
      "cache-delete",
      "--input",
      "-"
     ],
     "stdin_json": {
      "data": {
       "domain": "user",
       "kind": "episode",
       "title": "Synthetic CLI memory",
       "text": "A private fictional observation.",
       "authority": "source_observed",
       "scope": "personal",
       "source_refs": [
        {
         "kind": "tool_result",
         "ref": "synthetic:cli"
        }
       ]
      },
      "status": "active"
     },
     "save": "row"
    },
    {
     "cli": [
      "status"
     ]
    },
    {
     "cli": [
      "forget",
      "${row.id}",
      "--revision",
      "1"
     ],
     "files": {
      "--evidence": {
       "kind": "human_confirmation",
       "actor": "alex@example.com",
       "statement": "I reviewed this exact synthetic memory change.",
       "evidence_ref": "conversation:synthetic/session/turn/1",
       "subject_id": "${row.id}",
       "revision": 1,
       "decision": "forget",
       "decided_at": "2020-01-01T00:00:00+00:00"
      }
     }
    },
    {
     "sql": "DROP TABLE semantic_documents"
    },
    {
     "cli": [
      "index",
      "--rebuild"
     ]
    },
    {
     "cli": [
      "show",
      "${row.id}"
     ]
    }
   ],
   "expect_exit": 0,
   "state_args": false
  }
 ]
}
