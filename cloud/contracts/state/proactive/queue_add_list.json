{
  "description": "proactive_state.py queue-add and queue-list: inline and stdin JSON, --tier, computed and explicit revisions, revision-aware replay (test_revision_aware_dedupe_and_cli_seen), changed content refused, every _item validation error, parse_json errors, text and JSON views (str() of non-string titles), lone surrogates and storage errors",
  "steps": [
    {"script": "proactive_state.py", "args": ["queue-list"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-list", "--format", "json"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\",\"title\":\"Example\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\",\"title\":\"Example\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\",\"title\":\"Example\",\"tier\":\"urgent\",\"ts\":\"2026-01-01T09:00:00+09:00\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\",\"title\":\"material change\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v2\",\"title\":\"Example\"}", "--tier", "urgent"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "-"], "stdin": {"id": "two", "title": "From stdin", "family": "mail", "scope": {"folder": "inbox"}, "ts": "2026-01-01T00:00:00Z", "evidence": [1, 2.5, true, null]}, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "-", "--tier", ""], "stdin": "{\"id\":\"two\",\"title\":\"From stdin\",\"family\":\"mail\",\"scope\":{\"folder\":\"inbox\"},\"evidence\":[1,2.5,true,null]}", "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"three\",\"scope\":\"calendar-id\",\"family\":\"calendar.v2:x-y_z\",\"ts\":\"2025-12-31T23:00:00-01:00\",\"batch\":\"b\",\"owner\":\"o\",\"drained_at\":\"x\",\"lease_expires_at\":\"y\",\"item_key\":\"k\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"four\",\"title\":{\"nested\":[1,\"two\",null,false,1.5e+16]},\"tier\":\"sweep\",\"ts\":\"2026-01-02T00:00:00Z\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"five\",\"title\":\"Caf\u00e9 \u2615 \ud83d\ude00 \u05e9\u05dc\u05d5\u05dd\",\"ts\":\"2026-01-03T00:00:00Z\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"six\",\"title\":12,\"tier\":7.25,\"ts\":\"2026-01-03T00:00:01Z\",\"revision\":\"r\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"six\",\"title\":12,\"ts\":\"2026-01-03T00:00:01Z\",\"revision\":\"r\"}", "--tier", "manual"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-list"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-list", "--format", "json"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"   \"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"a\\u0000b\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":7}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"family\":\"-bad\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"family\":null}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"family\":\"f\u00e9\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"family\":\"a12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"family\":\"a1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"scope\":[1]}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"scope\":null}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"revision\":\"\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"revision\":null}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"ts\":\"2026-01-01\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"ts\":\"2026-02-30T00:00:00Z\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"ts\":{\"at\":1}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"ts\":[\"2026-01-01T00:00:00Z\"]}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"tier\":null}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"x\",\"tier\":\" \"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "[1]"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "\"text\""], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"id\":\"two\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"number\":NaN}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"number\":1e400}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", ""], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "-"], "stdin": "", "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"lone\",\"title\":\"\\ud800\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"lone\",\"revision\":\"v1\",\"title\":\"\\udfff\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"\udcff\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["seen", "\udcff", "--revision", "v1"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"ok\",\"revision\":\"v1\"}", "--tier", "\udcff"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-list", "--format", "yaml"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-list", "--form", "json"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["status"], "expect_exit": 0}
  ]
}
