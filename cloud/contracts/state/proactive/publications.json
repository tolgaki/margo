    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"bogus\",\"receipt\":{}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":7,\"receipt\":{}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":null}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T00:00:00Z\",\"extra\":1}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2999-01-01T00:00:00Z\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T00:00:00Z\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"r\",\"published_at\":\"2026-01-02T00:00:00Z\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-01\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"hosted\",\"content\":\"c\",\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T09:00:00+09:00\"}}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"status\":\"prepared\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"\",\"content\":\"c\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":5,\"content\":\"c\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"extra\":1}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"  \"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "[1]"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"content\":\"d\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "missing", "--json", "{\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "{\"status\":\"prepared\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "{\"status\":\"available\",\"receipt\":{\"kind\":\"local\"},\"x\":1}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "{\"status\":\"available\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "{\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T00:00:00Z\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "hosted", "--json", "{\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T09:00:00+09:00\"}}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-publish", "null-receipt", "--json", "{\"status\":\"published\",\"receipt\":{\"kind\":\"host\",\"receipt_id\":\"host-id\",\"location\":\"host://output/1\",\"published_at\":\"2026-01-02T00:00:00Z\"}}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-publish", "null-receipt", "--json", "{\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "", "--json", "{\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-list", "--limit", "1000"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["status"], "expect_exit": 0}
