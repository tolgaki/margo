{
  "description": "Standalone outputs and receipt validation (test_standalone_output_lifecycle_needs_no_dummy_items_or_ack): record/replay/publish/list/show/review without queue items, mode conflicts, every _receipt and publication-record field error, publication-publish and publication-review errors, review timestamps",
  "steps": [
    {"script": "proactive_probe.py", "args": ["cli", "queue-drain", "--owner", "empty-anchor"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"standalone-1\",\"content\":\"A brief with no queued inputs\",\"status\":\"prepared\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"standalone-1\",\"content\":\"A brief with no queued inputs\",\"status\":\"prepared\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["status"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-review", "standalone-1"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "{\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-publish", "standalone-1", "--json", "-"], "stdin": {"status": "available", "receipt": {"kind": "local"}}, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-list"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["status"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-show", "standalone-1"], "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-ack", "--receipt", "standalone-1", "--batch", "@{batch}"], "state_args": true, "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-ack", "x", "--receipt", "standalone-1"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"standalone-1\",\"content\":\"Changed\",\"status\":\"prepared\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"other\",\"content\":\"A brief with no queued inputs\",\"status\":\"prepared\",\"ids\":[\"one\"]}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"other\",\"content\":\"c\",\"status\":\"prepared\",\"item_keys\":[\"k\"]}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"other\",\"content\":\"c\",\"status\":\"prepared\",\"ids\":{}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"other\",\"content\":\"c\",\"status\":\"prepared\",\"ids\":[],\"item_keys\":null}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--batch", "anything", "--json", "{\"id\":\"standalone-1\",\"content\":\"A brief with no queued inputs\",\"status\":\"prepared\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"Another standalone output\",\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-review", "standalone-1", "--at", "2026-01-01T00:00:00Z"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-review", "standalone-1", "--at", "yesterday"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-review", "standalone-1", "--at", "2999-01-01T00:00:00+05:00"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-review", "standalone-1"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-review", "missing"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-review", "other"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-show", "standalone-1"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"prepared\",\"receipt\":{\"kind\":\"local\"}}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"id\":\"null-receipt\",\"content\":\"c\",\"status\":\"prepared\",\"receipt\":null}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-record", "--json", "{\"content\":\"c\",\"status\":\"available\"}"], "expect_exit": 2},
