{
  "description": "Queue to publication to acknowledgement through the CLI (test_cli_delivery_and_coverage_end_to_end, test_revision_aware_dedupe_and_cli_seen): drain, record an available output, ack, replays, seen exit codes by revision/family/scope, mark as a receipt-bound compatibility ack, exact item_keys",
  "steps": [
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\"}"], "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-drain", "--owner", "cli-anchor", "--format", "json"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "publication-record", "--batch", "@{batch}", "--json", "{\"content\":\"CLI brief\",\"ids\":[\"one\"],\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-ack", "--batch", "@{batch}", "--receipt", "@{publication}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-ack", "--batch", "@{batch}", "--receipt", "@{publication}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v1"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v1", "--family", "mail"], "expect_exit": 1},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v1", "--scope", "{\"a\":1}"], "expect_exit": 1},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v1", "--scope", " { } "], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v3"], "expect_exit": 1},
    {"script": "proactive_state.py", "args": ["seen", "missing", "--revision", "v1"], "expect_exit": 1},
    {"script": "proactive_probe.py", "args": ["cli", "mark", "one", "--receipt", "@{publication}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "mark", "one", "--receipt", "@{publication}", "--tier", "manual", "--note", "ignored"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "mark", "two", "--receipt", "@{publication}"], "state_args": true, "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["mark", "one", "--receipt", "missing"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["mark", "one", "--receipt", ""], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v1\",\"title\":\"Example\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v2\",\"title\":\"Example\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v2\",\"title\":\"Example\"}"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v2\",\"title\":\"material change\"}"], "expect_exit": 2},
    {"script": "proactive_state.py", "args": ["queue-add", "--json", "{\"id\":\"one\",\"revision\":\"v3\",\"title\":\"Example\"}"], "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-drain", "--limit", "1", "--format", "json"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v2"], "expect_exit": 1},
    {"script": "proactive_probe.py", "args": ["cli", "publication-record", "--batch", "@{batch}", "--json", "{\"content\":\"exact version\",\"item_keys\":[\"@{item:-2}\"],\"status\":\"available\",\"receipt\":{\"kind\":\"local\"}}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_probe.py", "args": ["cli", "queue-ack", "--receipt", "@{publication}", "--batch", "@{batch}"], "state_args": true, "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v2"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["seen", "one", "--revision", "v3"], "expect_exit": 1},
    {"script": "proactive_state.py", "args": ["queue-list"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["publication-list"], "expect_exit": 0},
    {"script": "proactive_state.py", "args": ["status"], "expect_exit": 0}
  ]
}
