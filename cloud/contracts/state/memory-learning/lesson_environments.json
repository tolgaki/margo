{
  "description": "Lessons combine only compatible pinned environments; a lesson grounded in an existing execution receipt of an installed skill is runtime-validated, and editing the skill file makes the active lesson ineligible without any inventory or human mutation.",
  "steps": [
    {
      "script": "memory_learning_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "write": "tools.json",
          "json": {
            "environment": {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "synthetic-fetch",
                "version": "v1",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ]
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/tools.json"
          },
          "save": "cap0_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${cap0_observed.memory_ids.0}"
          ],
          "save": "cap0"
        },
        {
          "write": "success-cap.json",
          "json": {
            "synthetic": true,
            "environment": "${cap0.metadata.environment_requirements}",
            "capability_id": "${cap0.id}",
            "input": {
              "query": "synthetic query"
            }
          },
          "save": "success-cap_sha"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap0.id}",
            1,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-cap.json",
                "sha256": "${success-cap_sha}"
              }
            }
          ],
          "save": "cap"
        },
        {
          "write": "other.json",
          "json": {
            "environment": {
              "host": "other-host",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "other-tool",
                "version": "v1",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ]
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/other.json"
          },
          "save": "other0_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${other0_observed.memory_ids.0}"
          ],
          "save": "other0"
        },
        {
          "write": "success-other.json",
          "json": {
            "synthetic": true,
            "environment": "${other0.metadata.environment_requirements}",
            "capability_id": "${other0.id}",
            "input": {
              "query": "synthetic query"
            }
          },
          "save": "success-other_sha"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${other0.id}",
            1,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-other.json",
                "sha256": "${success-other_sha}"
              }
            }
          ],
          "save": "other"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "mixed",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": 2
                },
                {
                  "id": "${other.id}",
                  "revision": 2
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ]
        },
        {
          "write": "third.json",
          "json": {
            "environment": {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "third-tool",
                "version": "v3",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ],
            "scope": "third-scope"
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/third.json"
          },
          "save": "third0_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${third0_observed.memory_ids.0}"
          ],
          "save": "third0"
        },
        {
          "write": "success-third.json",
          "json": {
            "synthetic": true,
            "environment": "${third0.metadata.environment_requirements}",
            "capability_id": "${third0.id}",
            "input": {
              "query": "synthetic query"
            }
          },
          "save": "success-third_sha"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${third0.id}",
            1,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-third.json",
                "sha256": "${success-third_sha}"
              }
            }
          ],
          "save": "third"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "combined",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": 2
                },
                {
                  "id": "${third.id}",
                  "revision": 2
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                },
                {
                  "capability_id": "${third.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-third.json",
                      "sha256": "${success-third_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "combined"
        },
        {
          "mkdir": "skills/synthetic-skill"
        },
        {
          "write": "skills/synthetic-skill/SKILL.md",
          "text": "# Synthetic skill version one\n"
        },
        {
          "call": "capabilities",
          "on": "learning",
          "args": [
            "${dir}/skills",
            {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            }
          ],
          "save": "skills"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${skills.memory_ids.0}"
          ],
          "save": "skill"
        },
        {
          "call": "source",
          "on": "ledger",
          "args": [
            "synthetic",
            "test",
            "fixture-1",
            "v1",
            {
              "synthetic": true
            },
            "https://example.com/synthetic"
          ],
          "save": "src1"
        },
        {
          "call": "ingest",
          "on": "ledger",
          "args": [
            {
              "title": "Synthetic action receipt fixture",
              "owner": null,
              "due": null,
              "direction": "owe",
              "source_refs": [
                "${src1}"
              ]
            },
            "claim-1"
          ],
          "save": "item1"
        },
        {
          "call": "propose",
          "on": "ledger",
          "args": [
            {
              "kind": "mail.reply",
              "target": {
                "message_id": "synthetic-message-1",
                "recipients": [
                  "dana@example.com"
                ]
              },
              "payload": {
                "body": "Synthetic fixture; never delivered."
              },
              "why": "Local receipt regression test, not a live tool call",
              "source_refs": [
                "${src1}"
              ],
              "target_fingerprint": "synthetic-v1",
              "work_item_id": "${item1.id}"
            }
          ],
          "save": "act1"
        },
        {
          "call": "approve",
          "on": "ledger",
          "args": [
            "${act1.id}",
            1,
            "${act1.action_hash}",
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${act1.id}",
              "revision": 1,
              "decision": "approve",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}",
              "action_hash": "${act1.action_hash}"
            },
            "${now+30m}"
          ]
        },
        {
          "call": "begin",
          "on": "ledger",
          "args": [
            "${act1.id}",
            1,
            {
              "checked_at": "${now}",
              "target_fingerprint": "synthetic-v1",
              "source_refs": [
                "${src1}"
              ]
            }
          ],
          "save": "att1"
        },
        {
          "call": "finish",
          "on": "ledger",
          "args": [
            "${att1.attempt_id}",
            "succeeded",
            {
              "kind": "tool_result",
              "reference": "tool:synthetic-existing-receipt",
              "outcome": "succeeded",
              "recorded_at": "2026-08-01T00:00:00Z",
              "environment": "${skill.metadata.environment_requirements}",
              "capability_id": "${skill.id}",
              "capability_hash": "${skill.metadata.content_hash}"
            }
          ]
        },
        {
          "sql": "UPDATE work_executions SET id=? WHERE id=?",
          "params": [
            "exec_att1",
            "${att1.attempt_id}"
          ]
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${skill.id}",
            1,
            {
              "kind": "execution_receipt",
              "attempt_id": "exec_att1"
            }
          ],
          "save": "skillcap"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "skill-lesson",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${skillcap.id}",
                  "revision": "${skillcap.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${skillcap.id}",
                  "observation": {
                    "kind": "execution_receipt",
                    "attempt_id": "exec_att1"
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "skill_lesson"
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${skill_lesson.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${skill_lesson.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ],
          "save": "skill_active"
        },
        {
          "call": "eligible",
          "on": "store",
          "kwargs": {
            "environment": "${skillcap.metadata.environment_requirements}"
          }
        },
        {
          "write": "skills/synthetic-skill/SKILL.md",
          "text": "# Synthetic skill version two\n"
        },
        {
          "call": "eligible",
          "on": "store",
          "kwargs": {
            "environment": "${skillcap.metadata.environment_requirements}"
          }
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${skill_active.id}"
          ]
        }
      ]
    }
  ]
}
