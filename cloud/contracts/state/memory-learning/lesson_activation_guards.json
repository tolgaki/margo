{
  "description": "activate_lesson refuses failure-only recipes, passed review deadlines, capability revisions that moved or are not validated, and observations whose fixture changed after the proposal.",
  "steps": [
    {
      "script": "memory_learning_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "write": "tools.json",
          "json": {
            "environment": {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "synthetic-fetch",
                "version": "v1",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ]
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/tools.json"
          },
          "save": "cap0_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${cap0_observed.memory_ids.0}"
          ],
          "save": "cap0"
        },
        {
          "write": "success-cap.json",
          "json": {
            "synthetic": true,
            "environment": "${cap0.metadata.environment_requirements}",
            "capability_id": "${cap0.id}",
            "input": {
              "query": "synthetic query"
            }
          },
          "save": "success-cap_sha"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap0.id}",
            1,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-cap.json",
                "sha256": "${success-cap_sha}"
              }
            }
          ],
          "save": "cap"
        },
        {
          "write": "counterexample.json",
          "json": {
            "synthetic": true,
            "environment": "${cap.metadata.environment_requirements}",
            "capability_id": "${cap.id}",
            "input": {
              "query": 42
            }
          },
          "save": "counterexample_sha"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "failed-only",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": "${cap.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/counterexample.json",
                      "sha256": "${counterexample_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "failed_only"
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${failed_only.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${failed_only.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "expired",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": "${cap.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                }
              ],
              "counterexamples": [],
              "review_after": "2026-01-01T00:00:00Z"
            }
          ],
          "save": "expired"
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${expired.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${expired.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "drifted",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": "${cap.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "drifted"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap.id}",
            2,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/counterexample.json",
                "sha256": "${counterexample_sha}"
              }
            }
          ],
          "save": "degraded"
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${drifted.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${drifted.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "from-degraded",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${degraded.id}",
                  "revision": "${degraded.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${degraded.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "from_degraded"
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${from_degraded.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${from_degraded.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap.id}",
            3,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-cap.json",
                "sha256": "${success-cap_sha}"
              }
            }
          ]
        },
        {
          "write": "fresh-success.json",
          "json": {
            "synthetic": true,
            "environment": "${cap.metadata.environment_requirements}",
            "capability_id": "${cap.id}",
            "input": {
              "query": "fresh"
            }
          },
          "save": "fresh-success_sha"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${cap.id}"
          ],
          "save": "current"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap.id}",
            "${current.revision}",
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/fresh-success.json",
                "sha256": "${fresh-success_sha}"
              }
            }
          ],
          "save": "revalidated"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "evidence-drift",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${revalidated.id}",
                  "revision": "${revalidated.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${revalidated.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/fresh-success.json",
                      "sha256": "${fresh-success_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "evidence_drift"
        },
        {
          "write": "fresh-success.json",
          "json": {
            "synthetic": true,
            "changed": true
          }
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${evidence_drift.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${evidence_drift.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "eligible",
          "on": "store",
          "kwargs": {
            "environment": "${revalidated.metadata.environment_requirements}"
          }
        }
      ]
    }
  ]
}
