{
  "description": "Fixture drift after a preview and forgotten targets are refused at delivery; forgotten records are not proposed again.",
  "steps": [
    {
      "script": "memory_learning_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "write": "tools.json",
          "json": {
            "environment": {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "synthetic-fetch",
                "version": "v1",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ]
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/tools.json"
          },
          "save": "cap0_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${cap0_observed.memory_ids.0}"
          ],
          "save": "cap0"
        },
        {
          "write": "success-cap.json",
          "json": {
            "synthetic": true,
            "environment": "${cap0.metadata.environment_requirements}",
            "capability_id": "${cap0.id}",
            "input": {
              "query": "synthetic query"
            }
          },
          "save": "success-cap_sha"
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap0.id}",
            1,
            {
              "kind": "synthetic_observation",
              "fixture": {
                "path": "${dir}/success-cap.json",
                "sha256": "${success-cap_sha}"
              }
            }
          ],
          "save": "cap"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "candidate-lesson",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${cap.id}",
                  "revision": "${cap.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${cap.id}",
                  "observation": {
                    "kind": "synthetic_observation",
                    "fixture": {
                      "path": "${dir}/success-cap.json",
                      "sha256": "${success-cap_sha}"
                    }
                  }
                }
              ],
              "counterexamples": []
            }
          ],
          "save": "candidate"
        },
        {
          "call": "consolidation_plan",
          "on": "consolidation",
          "save": "p1"
        },
        {
          "write": "success-cap.json",
          "json": {
            "synthetic": true,
            "changed": true
          }
        },
        {
          "call": "surface_consolidation",
          "on": "consolidation",
          "args": [
            "${p1}"
          ]
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "forgettable",
            {
              "domain": "agent",
              "kind": "episode",
              "authority": "source_observed",
              "title": "Synthetic bounded review",
              "text": "forgettable",
              "scope": "synthetic",
              "source_refs": [
                {
                  "kind": "tool_result",
                  "ref": "synthetic:forgettable"
                }
              ]
            }
          ],
          "save": "record"
        },
        {
          "call": "consolidation_plan",
          "on": "consolidation",
          "save": "fresh"
        },
        {
          "call": "forget",
          "on": "store",
          "args": [
            "${record.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${record.id}",
              "revision": 1,
              "decision": "forget",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "surface_consolidation",
          "on": "consolidation",
          "args": [
            "${fresh}"
          ]
        },
        {
          "call": "consolidation_plan",
          "on": "consolidation"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${candidate.id}"
          ]
        }
      ]
    }
  ]
}
