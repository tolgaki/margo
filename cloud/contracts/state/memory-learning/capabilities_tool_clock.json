          "sql": "DELETE FROM memory_meta WHERE key LIKE 'learning:inventory-clock:%'"
        },
        {
          "call": "_digest",
          "on": "learning",
          "args": [
            "${dir}/legacy.json"
          ],
          "save": "legacy"
        },
        {
          "call": "put",
          "on": "store",
          "args": [
