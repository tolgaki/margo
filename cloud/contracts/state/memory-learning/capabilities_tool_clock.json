                  "kind": "tool_result",
                  "ref": "synthetic:legacy"
                }
              ],
              "metadata": {
                "capability_kind": "tool",
                "name": "legacy-tool",
                "origin": "tools:${legacy}",
                "base_environment": {
                  "account": "${account}",
                  "host": "synthetic-cli",
                  "runtime": "python-synthetic"
                },
                "observed_at": "2026-08-10T00:00:00Z"
