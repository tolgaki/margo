          "on": "store",
          "args": [
            "${cap.id}"
          ]
        },
        {
          "sql": "UPDATE memory_meta SET value='{\"observed_at\":\"not a time\"}' WHERE key LIKE 'learning:inventory-clock:%'"
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/same-stamp.json"
