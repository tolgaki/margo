{
  "description": "_feedback and lesson feedback_refs: only an existing, exact, recorded Work feedback record with human evidence and without do_not_learn grounds a lesson, and activation re-reads it.",
  "steps": [
    {
      "script": "memory_learning_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/work"
      ],
      "stdin": [
        {
          "write": "tools.json",
          "json": {
            "environment": {
              "host": "synthetic-cli",
              "account": "${account}",
              "runtime": "python-synthetic"
            },
            "observed_at": "2026-08-01T00:00:00Z",
            "complete": true,
            "tools": [
              {
                "name": "synthetic-fetch",
                "version": "v1",
                "exposed": true,
                "input_schema": {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "properties": {
                    "query": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "required_permissions": [
                  "read.synthetic"
                ],
                "dependencies": {
                  "transport": "v1"
                }
              }
            ]
          }
        },
        {
          "call": "capabilities",
          "on": "learning",
          "kwargs": {
            "tools": "${dir}/tools.json"
          },
          "save": "cap_observed"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${cap_observed.memory_ids.0}"
          ],
          "save": "cap"
        },
        {
          "call": "source",
          "on": "ledger",
          "args": [
            "synthetic",
            "test",
            "fixture-1",
            "v1",
            {
              "synthetic": true
            },
            "https://example.com/synthetic"
          ],
          "save": "src1"
        },
        {
          "call": "ingest",
          "on": "ledger",
          "args": [
            {
              "title": "Synthetic action receipt fixture",
              "owner": null,
              "due": null,
              "direction": "owe",
              "source_refs": [
                "${src1}"
              ]
            },
            "claim-1"
          ],
          "save": "item1"
        },
        {
          "call": "propose",
          "on": "ledger",
          "args": [
            {
              "kind": "mail.reply",
              "target": {
                "message_id": "synthetic-message-1",
                "recipients": [
                  "dana@example.com"
                ]
              },
              "payload": {
                "body": "Synthetic fixture; never delivered."
              },
              "why": "Local receipt regression test, not a live tool call",
              "source_refs": [
                "${src1}"
              ],
              "target_fingerprint": "synthetic-v1",
              "work_item_id": "${item1.id}"
            }
          ],
          "save": "act1"
        },
        {
          "call": "approve",
          "on": "ledger",
          "args": [
            "${act1.id}",
            1,
            "${act1.action_hash}",
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${act1.id}",
              "revision": 1,
              "decision": "approve",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}",
              "action_hash": "${act1.action_hash}"
            },
            "${now+30m}"
          ]
        },
        {
          "call": "begin",
          "on": "ledger",
          "args": [
            "${act1.id}",
            1,
            {
              "checked_at": "${now}",
              "target_fingerprint": "synthetic-v1",
              "source_refs": [
                "${src1}"
              ]
            }
          ],
          "save": "att1"
        },
        {
          "call": "finish",
          "on": "ledger",
          "args": [
            "${att1.attempt_id}",
            "succeeded",
            {
              "kind": "tool_result",
              "reference": "tool:synthetic-existing-receipt",
              "outcome": "succeeded",
              "recorded_at": "2026-08-01T00:00:00Z",
              "environment": "${cap.metadata.environment_requirements}",
              "capability_id": "${cap.id}",
              "capability_hash": "${cap.metadata.content_hash}"
            }
          ]
        },
        {
          "sql": "UPDATE work_executions SET id=? WHERE id=?",
          "params": [
            "exec_att1",
            "${att1.attempt_id}"
          ]
        },
        {
          "call": "validation",
          "on": "learning",
          "args": [
            "${cap.id}",
            1,
            {
              "kind": "execution_receipt",
              "attempt_id": "exec_att1"
            }
          ],
          "save": "validated"
        },
        {
          "call": "record_id",
          "on": "products",
          "args": [
            "feedback",
            "synthetic-feedback"
          ],
          "save": "feedback_id"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "synthetic-feedback",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "correction": "Use a nonempty string query."
            }
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${feedback_id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          },
          "save": "feedback"
        },
        {
          "call": "record_id",
          "on": "products",
          "args": [
            "feedback",
            "opted-out"
          ],
          "save": "opted_id"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "opted-out",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "do_not_learn": true
            }
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${opted_id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          },
          "save": "opted"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "unreviewed",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "correction": "x"
            }
          ]
        },
        {
          "call": "record_id",
          "on": "products",
          "args": [
            "feedback",
            "unreviewed"
          ],
          "save": "unreviewed_id"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "unreviewed",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "correction": "x"
            }
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${unreviewed_id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          },
          "save": "unreviewed"
        },
        {
          "sql": "UPDATE work_record_revisions SET evidence=NULL WHERE record_id=?",
          "params": [
            "${unreviewed.id}"
          ]
        },
        {
          "call": "record_id",
          "on": "products",
          "args": [
            "feedback",
            "data-opted"
          ],
          "save": "data_opted_id"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "data-opted",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "correction": "y"
            }
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${data_opted_id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          },
          "save": "data_opted"
        },
        {
          "sql": "UPDATE work_records SET data=json_set(data, '$.do_not_learn', json('true')) WHERE id=?",
          "params": [
            "${data_opted.id}"
          ]
        },
        {
          "call": "record_id",
          "on": "products",
          "args": [
            "feedback",
            "forged"
          ],
          "save": "forged_id"
        },
        {
          "call": "put",
          "on": "products",
          "args": [
            "feedback",
            "forged",
            {
              "subject_id": "${act1.id}",
              "subject_revision": 1,
              "correction": "z"
            }
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${forged_id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          },
          "save": "forged"
        },
        {
          "sql": "UPDATE work_record_revisions SET evidence='{\"kind\":\"human_confirmation\"}' WHERE record_id=?",
          "params": [
            "${forged.id}"
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${data_opted.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${forged.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${feedback.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${feedback.id}",
              "revision": 1
            }
          ],
          "account": "other-synthetic@example.com"
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${opted.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${unreviewed.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${feedback.id}",
              "revision": 99
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${feedback.id}",
              "revision": 1.0
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${feedback.id}"
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": {
                "nested": true
              },
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "nonexistent",
              "revision": 1
            }
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            [
              "${feedback.id}",
              1
            ]
          ]
        },
        {
          "call": "_feedback",
          "on": "learning",
          "args": [
            {
              "id": "${item1.id}",
              "revision": 1
            }
          ]
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "feedback-lesson",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${validated.id}",
                  "revision": "${validated.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${validated.id}",
                  "observation": {
                    "kind": "execution_receipt",
                    "attempt_id": "exec_att1"
                  }
                }
              ],
              "counterexamples": [],
              "feedback_refs": [
                {
                  "id": "${feedback.id}",
                  "revision": 1
                }
              ]
            }
          ],
          "save": "lesson"
        },
        {
          "call": "lesson_plan",
          "on": "learning",
          "args": [
            "bad-feedback",
            {
              "title": "Use the exposed synthetic query input shape",
              "scope": "synthetic query preparation",
              "trigger": "Before preparing the synthetic query",
              "goal": "Avoid an invalid input shape",
              "preconditions": [
                "Use the pinned host and tool schema"
              ],
              "procedure": [
                "Provide a nonempty string query.",
                "Keep every external action behind its existing approval."
              ],
              "risk": "read_only",
              "capability_refs": [
                {
                  "id": "${validated.id}",
                  "revision": "${validated.revision}"
                }
              ],
              "evidence": [
                {
                  "capability_id": "${validated.id}",
                  "observation": {
                    "kind": "execution_receipt",
                    "attempt_id": "exec_att1"
                  }
                }
              ],
              "counterexamples": [],
              "feedback_refs": [
                {
                  "id": "${opted.id}",
                  "revision": 1
                }
              ]
            }
          ]
        },
        {
          "sql": "UPDATE work_records SET state='archived' WHERE id=?",
          "params": [
            "${feedback.id}"
          ]
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${lesson.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${lesson.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "sql": "UPDATE work_records SET state='recorded' WHERE id=?",
          "params": [
            "${feedback.id}"
          ]
        },
        {
          "call": "activate_lesson",
          "on": "learning",
          "args": [
            "${lesson.id}",
            1,
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${lesson.id}",
              "revision": 1,
              "decision": "confirm",
              "statement": "I reviewed this exact synthetic proposal.",
              "evidence_ref": "conversation:synthetic/review/1",
              "decided_at": "${now}"
            }
          ]
        }
      ]
    }
  ]
}
