{
  "description": "Replacement and scope rules of the constraint guard: a current confirmed superseding preference satisfies it without reciting the old text; a successor scoped to another routine or environment does not hide the original where it still applies; twelve unavailable constraints stay an explicit block under a 1000-character budget with omitted gaps counted.",
  "account": "context-fixture@example.com",
  "steps": [
    {
      "script": "memory_search_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}"
      ],
      "stdin": [
        {
          "call": "put",
          "on": "store",
          "args": [
            "old-restriction",
            {
              "domain": "user",
              "kind": "preference",
              "title": "old-restriction",
              "text": "Old private prohibition.",
              "authority": "user_confirmed",
              "scope": "fixture",
              "source_refs": [
                {
                  "kind": "user_statement",
                  "ref": "conversation:fixture"
                }
              ]
            },
            "active"
          ],
          "save": "old-restriction",
          "kwargs": {
            "revision": 1,
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${id:user:old-restriction}",
              "revision": 1,
              "decision": "confirm",
              "statement": "Confirm this synthetic fixture.",
              "evidence_ref": "conversation:fixture",
              "decided_at": "${now}"
            }
          }
        },
        {
          "call": "put",
          "on": "store",
          "args": [
            "current-restriction",
            {
              "domain": "user",
              "kind": "preference",
              "title": "current-restriction",
              "text": "Current accepted rule.",
              "authority": "user_confirmed",
              "scope": "fixture",
              "source_refs": [
                {
                  "kind": "user_statement",
                  "ref": "conversation:fixture"
                }
              ]
            },
            "active"
          ],
          "save": "current-restriction",
          "kwargs": {
            "revision": 1,
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${id:user:current-restriction}",
              "revision": 1,
              "decision": "confirm",
              "statement": "Confirm this synthetic fixture.",
              "evidence_ref": "conversation:fixture",
              "decided_at": "${now}"
            }
          }
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${id:user:current-restriction}"
          ],
          "save": "_left"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${id:user:old-restriction}"
          ],
          "save": "_right"
        },
        {
          "call": "link",
          "on": "store",
          "args": [
            "${_left.id}",
            "${_right.id}",
            "supersedes",
            "${_left.revision}"
          ],
          "kwargs": {
            "evidence": {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${_left.id}",
              "revision": "${_left.revision}",
              "decision": "relate",
              "statement": "Confirm this synthetic fixture.",
              "evidence_ref": "conversation:fixture",
              "decided_at": "${now}"
            },
            "data": {},
            "target_revision": "${_right.revision}"
          }
        },
        {
          "call": "context",
          "on": "search",
          "args": [
            "unmatched-query"
          ],
          "kwargs": {
            "mode": "lexical"
          }
        },
        {
          "call": "graph",
          "on": "search",
          "args": [
            "${id:user:old-restriction}"
          ]
        },
        {
          "sql": "SELECT data FROM memory_records WHERE id=?",
          "params": [
            "${id:user:old-restriction}"
          ],
          "save": "_data"
        },
        {
          "call": "show",
          "on": "store",
          "args": [
            "${id:user:old-restriction}"
          ],
          "save": "_row"
        },
        {
          "call": "revise",
          "on": "store",
          "args": [
            "${id:user:old-restriction}",
            "${json:_data.rows.0.0}",
            "superseded",
            "${_row.revision}",
            {
              "kind": "human_confirmation",
              "actor": "dana@example.com",
              "subject_id": "${id:user:old-restriction}",
              "revision": "${_row.revision}",
              "decision": "supersede",
              "statement": "Confirm this synthetic fixture.",
              "evidence_ref": "conversation:fixture",
              "decided_at": "${now}"
            }
          ]
        },
        {
          "call": "context",
          "on": "search",
          "args": [
            "unmatched-query"
          ],
          "kwargs": {
            "mode": "lexical"
          }
        }
      ]
