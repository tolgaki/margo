          "input": {
            "run_id": "${run.id}",
            "step_key": "prepare",
            "revision": 1,
            "plan_hash": "${run.plan_hash}",
            "binding": "${run.plan.environment}"
          }
        },
        {
          "cli": [
            "resume"
          ],
          "input": {
            "run_id": "${run.id}",
            "revision": "${paused.revision}",
            "binding": "${run.plan.environment}"
