{
  "description": "tasks_probe: the full local workflow across commands (test_read_setup_and_full_local_workflow_across_processes): record-id equals the created id, idempotent create from a file and from the normalised plan, a different plan for the same identity, pause/resume (revision, state, binding), claim refusals (paused, revision, plan hash, unknown step, bool revision, preflight on a local step), settlement (wrong token, failure without proof of no effect, receipt kind, unsupported fields), replayed and immutable settlement, history without tokens, list summaries, health, and a completed run refusing pause/resume while cancel/recover/sync return it unchanged.",
  "steps": [
    {
      "script": "tasks_probe.py",
      "args": [
        "--account",
        "{account}",
        "--state-dir",
        "{state_dir}",
        "--dir",
        "{root}/probe"
      ],
      "stdin": [
        {
          "cli": [
            "list"
          ]
        },
        {
          "cli": [
            "record-id",
            "note"
          ],
          "save": "identity"
        },
        {
          "cli": [
            "init"
          ]
        },
        {
          "write": "plan.json",
          "json": {
            "goal": "Prepare a private synthetic note",
            "routine": "work-products",
            "request_ref": "conversation:synthetic-cli",
            "mode": "foreground",
            "environment": {
              "account": "${account}",
              "host": "synthetic-cli",
              "capabilities": {
                "local.prepare": "v1"
              },
              "observed_at": "${now}"
            },
            "window": {
              "start": "${now-1m}",
              "end": "${now}"
            },
            "limits": {
              "tool_calls": 0,
              "pages": 0,
              "items": 0,
              "model_calls": 0,
              "output_chars": 4000,
              "max_steps": 2,
              "max_attempts_per_step": 2,
              "max_parallel": 1,
              "deadline_at": "${now+10m}",
              "lease_seconds": 60
            },
            "steps": [
              {
                "key": "prepare",
                "title": "Prepare note",
                "kind": "local",
                "capability": "local.prepare",
                "depends_on": [],
                "allow_partial": false,
                "cost": {
                  "tool_calls": 0,
                  "pages": 0,
                  "items": 0,
                  "model_calls": 0,
                  "output_chars": 2000
                }
              }
            ]
          }
        },
        {
          "cli": [
            "create",
            "note",
            "--input",
            "${dir}/plan.json"
          ],
          "save": "run"
        },
        {
          "cli": [
            "create",
            "note",
            "--input",
            "${dir}/plan.json"
          ]
        },
        {
          "cli": [
            "create",
            "note",
            "--input",
            "-"
          ],
          "stdin": "${run.plan}"
        },
        {
          "cli": [
            "create",
            "note"
          ],
          "input": {
            "goal": "A different request",
            "routine": "work-products",
            "request_ref": "conversation:synthetic-cli",
            "mode": "foreground",
            "environment": {
              "account": "${account}",
              "host": "synthetic-cli",
              "capabilities": {
                "local.prepare": "v1"
              },
              "observed_at": "${now}"
            },
            "window": {
              "start": "${now-1m}",
              "end": "${now}"
            },
            "limits": {
              "tool_calls": 0,
              "pages": 0,
              "items": 0,
              "model_calls": 0,
              "output_chars": 4000,
              "max_steps": 2,
              "max_attempts_per_step": 2,
              "max_parallel": 1,
              "deadline_at": "${now+10m}",
              "lease_seconds": 60
            },
            "steps": [
              {
                "key": "prepare",
                "title": "Prepare note",
                "kind": "local",
                "capability": "local.prepare",
