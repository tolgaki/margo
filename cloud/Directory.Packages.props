<Project>
  <!-- One version per package for the whole solution. Change a version here, nowhere else. -->
  <ItemGroup>
    <!-- Microsoft 365 Agents SDK and Agent 365 -->
    <PackageVersion Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.9.205" />
    <PackageVersion Include="Microsoft.Agents.Authentication.Msal" Version="1.9.205" />
    <PackageVersion Include="Microsoft.Agents.Builder" Version="1.9.205" />
    <PackageVersion Include="Microsoft.Agents.A365.Notifications" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Agents.A365.Runtime" Version="2.0.0" />
    <!-- Azure -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="Azure.ResourceManager.Resources" Version="1.12.0" />
    <PackageVersion Include="Azure.ResourceManager.Authorization" Version="1.1.7" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!-- Tokens (router and voice page sign-in checks) -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <!-- State -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
</Project>
