<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Margo.Cloud.Engine.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Expected values written inline in assertions read better than static fields. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Margo.Cloud.Engine/Margo.Cloud.Engine.csproj" />
    <!-- The real margo-state CLI, copied next to the tests: the state tool runs it as a separate process. -->
    <ProjectReference Include="../../src/Margo.Cloud.StateCli/Margo.Cloud.StateCli.csproj" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Asks the Python engine, skills, parity and statecmd modules (the specification) the tests' questions. -->
    <None Include="Parity/engine_cases.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- These tests start many processes (margo-state, python3); one class at a time keeps the machine responsive for
         the timing-sensitive tests of other assemblies that run alongside. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
