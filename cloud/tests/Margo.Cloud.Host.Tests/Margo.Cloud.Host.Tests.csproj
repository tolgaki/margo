<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Margo.Cloud.Host.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Expected values written inline in assertions read better than static fields. -->
    <!-- CS0436: the Agents SDK's source generator emits the same internal type into the host and the tests. -->
    <NoWarn>$(NoWarn);CA1861;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Margo.Cloud.Host/Margo.Cloud.Host.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The state bundle test writes a small SQLite database. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
