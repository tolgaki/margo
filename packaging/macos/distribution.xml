<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">

    <title>Margo</title>
    <organization>com.github.tolgaki</organization>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <license    file="LICENSE.txt"     mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- customize="always" puts the skill checkboxes in front of the user
         rather than hiding them behind a Customize button. -->
    <options customize="always" require-scripts="true" hostArchitectures="arm64,x86_64"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="core"/>
        <line choice="decision-log"/>
    </choices-outline>

    <!-- Always installed: the agent plus the chief-of-staff playbook. -->
    <choice id="core"
            title="Margo + chief-of-staff"
            description="The Margo agent and the chief-of-staff playbook: daily briefs, inbox triage, meeting prep, calendar management and drafting. Required."
            enabled="false"
            selected="true">
        <pkg-ref id="com.github.tolgaki.margo.core"/>
    </choice>

    <choice id="decision-log"
            title="decision-log skill"
            description="Optional. Keeps an append-only record of what the team decided and why, extracted from meetings, threads and pull requests."
            selected="false">
        <pkg-ref id="com.github.tolgaki.margo.decision-log"/>
    </choice>


    <pkg-ref id="com.github.tolgaki.margo.core"
             version="__VERSION__"
             onConclusion="none">margo-core.pkg</pkg-ref>

    <pkg-ref id="com.github.tolgaki.margo.decision-log"
             version="__VERSION__"
             onConclusion="none">margo-decision-log.pkg</pkg-ref>


</installer-gui-script>
